package piscine

import "fmt"

//Τελικά ο έλεγχος γίνεται στην αρχή αντί για το τέλος.
//Με αυτόν τον τρόπο αν κάποιο από τα x, y είναι αρνητικό τότε η συνάρτηση
//δεν επιστρέφει κάτι και τελειώνει.
//Το ίδιο συμβαίνει και αν κάποιο είναι 0, εξού και οι ισότητες.
func QuadA(x, y int) {
	if x <= 0 || y <= 0 {
		return
	}


	//Οι δύο for επαναλαμβάνουν την εκτύπωση με όρια τα x, y
	//Προχωράμε δλδ. στήλη στήλη και γραμμή γραμμή και ακτυπώνουμε τον σωστό χαρακτήρα
	for row := 1; row <= y; row++ {
		for col := 1; col <= x; col++ {
			//Ελέγχουμε αν είμαστε σε κάποια γωνία και τυπωνουμε 'ο'
			if (row == 1 && col == 1) || (row == 1 && col == x) ||
				(row == y && col == 1) || (row == y && col == x) {
				fmt.Print("o")
			//ελέγχουμε αν είμαστε στην πρώτη ή τελευταία γραμμή και τυπώνουμε '-'	
			} else if row == 1 || row == y {
				fmt.Print("-")
			//ελέγχουμε αν είμαστε στην πρώτη ή τελευταία στήλη και τυπώνουμε '|'
			} else if col == 1 || col == x {
				fmt.Print("|")
			//διαφορετικά τυπώνουμε ' '
			} else {
				fmt.Print(" ")
			}
		}
		fmt.Println()
	}
}